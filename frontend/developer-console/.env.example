# Base URL of the AI Footprint REST API (no trailing slash, no /v1 suffix).
# The console appends the versioned path (for example /v1/projects) itself.
# Local default below; production is https://api.aifootprint.tech (ADR-0012).
VITE_API_BASE_URL=http://localhost:8000

# Never commit a real API key. The developer API key is entered in the
# console's Connect screen at runtime and kept in sessionStorage only.
