# Copy to .env and adjust for your local environment. Never commit real secrets.

# Async application database URL (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://footprint:footprint@localhost:5432/footprint

# Environment name: development | staging | production | test
ENVIRONMENT=development

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Prefix used when generating new API keys, e.g. afp_live / afp_test
API_KEY_PREFIX=afp_dev
